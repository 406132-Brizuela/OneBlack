{
  "name": "oneblack",
  "productName": "OneBlack",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop orchestrator for AI agents and workspaces.",
  "author": "Tomas Brizuela",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron",
    "test:e2e": "electron-vite build && node --test --test-concurrency=1 tests/e2e/workspaces.e2e.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
